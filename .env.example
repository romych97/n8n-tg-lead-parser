# --- n8n ---
# Публичный HTTPS-адрес, по которому доступен n8n (например, из cloudflared tunnel)
WEBHOOK_URL=https://proposed-oriented-origins-movement.trycloudflare.com/
N8N_HOST=proposed-oriented-origins-movement.trycloudflare.com
# Любая длинная случайная строка: openssl rand -hex 32
N8N_ENCRYPTION_KEY=123abc
# Стабильнее для этого проекта, чем latest (2.x): N8N_VERSION=1.123.0
# N8N_VERSION=latest

LLM_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=qwen/qwen3.8-27b:free

# --- сборка workflow (npm run build) ---
# Подставляются в workflow при сборке, чтобы не править ноды руками после импорта
SPREADSHEET_ID=123abc /media/romych97/C23EE1AF3EE19D23/projects/tg-lead-parser

MANAGER_CHAT_ID=123456
 